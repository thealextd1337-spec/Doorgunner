extends Node
## Headless world generator test (docs/ROADMAP.md P8). main.gd adds this node when env SMOKE=world:
##   SMOKE=world godot --headless --path . --quit-after 30000
## 1. The same 30 chunks generated by two fresh generators in different orders (the second one starting far away)
##    come out tile for tile and prop for prop the same. 2. Sites: a town near the start, neighbouring sites
##    2200-3000 px apart on average, every site joined by road to a neighbour, sites_near finds them.
## 3. A flight across macro cells at heli speed stays under 50 ms per frame. WORLD_MAP=<png> also writes an overview.

const CM := preload("res://scripts/chunk_manager.gd")
const T := CM.T


func _ready() -> void:
	call_deferred("_run")


func _run() -> void:
	var main: Node2D = Game.world
	await get_tree().process_frame
	await get_tree().process_frame
	main.chunks.process_mode = Node.PROCESS_MODE_DISABLED
	# 1. order independence: 6x5 chunks across a macro border, row by row vs. reversed after a detour
	var chunks := []
	for y in range(-2, 3):
		for x in range(2, 8):
			chunks.append(Vector2i(x, y))
	var a := _fresh(main)
	var t0 := Time.get_ticks_usec()
	var props_a := _props(main, func(): for c in chunks: a._ensure(c))
	print("30 chunks in %.1f ms each" % ((Time.get_ticks_usec() - t0) / 1000.0 / 30))
	var b := _fresh(main)
	for c in [Vector2i(30, -12), Vector2i(-9, 14), Vector2i(12, 4)]: # another cache history first
		b._ensure(c)
	var rev := chunks.duplicate()
	rev.reverse()
	var props_b := _props(main, func(): for c in rev: b._ensure(c))
	var bad := 0
	for c: Vector2i in chunks:
		for k in CM.CHUNK * CM.CHUNK:
			var cell := c * CM.CHUNK + Vector2i(k % CM.CHUNK, k / CM.CHUNK)
			if a.get_cell_atlas_coords(cell) != b.get_cell_atlas_coords(cell) or a.get_cell_alternative_tile(cell) != b.get_cell_alternative_tile(cell):
				bad += 1
				if bad < 5:
					print("differs at %s: %s/%d vs %s/%d" % [cell, a.get_cell_atlas_coords(cell), a.get_cell_alternative_tile(cell), b.get_cell_atlas_coords(cell), b.get_cell_alternative_tile(cell)])
	assert(bad == 0, "same tiles in both orders (%d cells differ)" % bad)
	props_b = props_b.filter(func(p): return chunks.has(Vector2i((p[1] / (CM.CHUNK * CM.TILE)).floor())))
	props_a = props_a.filter(func(p): return chunks.has(Vector2i((p[1] / (CM.CHUNK * CM.TILE)).floor())))
	assert(var_to_str(props_a) == var_to_str(props_b), "same props and POIs in both orders (%d vs %d)" % [props_a.size(), props_b.size()])
	print("order independent: %d cells, %d props and POIs" % [chunks.size() * CM.CHUNK * CM.CHUNK, props_a.size()])
	# 2. sites
	var ch := a
	var home: Dictionary = ch.site(Vector2i.ZERO)
	var start := Vector2(CM.START) * CM.TILE
	assert(home.town and ch._mid(home.center, home.center).distance_to(start) <= 1200.0, "a town next to the start: %s" % home)
	var lengths := []
	var kinds := {}
	var joined := 0
	var linked := 0
	for x in range(-3, 4):
		for y in range(-3, 4):
			var m := Vector2i(x, y)
			var s: Dictionary = ch.site(m)
			kinds[s.kind] = kinds.get(s.kind, 0) + 1
			if s.kind == "":
				continue
			for q: Vector2i in ch._knn(m):
				lengths.append(Vector2(ch.site(q).center - s.center).length() * CM.TILE)
			if absi(x) <= 1 and absi(y) <= 1 and not ch._knn(m).is_empty():
				linked += 1
				joined += int(ch._knn(m).any(func(q): return _joined(ch, ch._layout(m).ports, ch._layout(q).ports)))
	var mean: float = lengths.reduce(func(s, l): return s + l, 0.0) / lengths.size()
	print("site kinds within 3 macro cells: %s" % kinds)
	print("road links: %d, mean length %.0f px; sites joined by road: %d / %d" % [lengths.size(), mean, joined, linked])
	assert(mean >= 2200.0 and mean <= 3000.0, "neighbouring sites 2200-3000 px apart on average")
	assert(joined == linked, "every site joined by road to a neighbour")
	var near: Array = ch.sites_near(start, 6000.0)
	assert(near.size() >= 3 and near[0].pos.distance_to(start) <= near[1].pos.distance_to(start), "sites_near sorted")
	var town: Array = ch.sites_near(start, 6000.0, home.kind)
	assert(town.size() > 0 and town.all(func(n): return n.kind == home.kind) and town[0].uid == "site:0,0", "sites_near by kind")
	# 3. a flight east across two macro borders at heli speed, 60 frames a second
	var c := _fresh(main)
	c.process_mode = Node.PROCESS_MODE_ALWAYS
	var heli: Node2D = Game.heli
	var keep: Vector2 = heli.position
	heli.position = Vector2(2000, 300)
	await get_tree().process_frame # the jump: everything around at once
	var worst := 0.0
	var frames := 0
	while heli.position.x < 9000.0:
		heli.position.x += 115.0 / 60.0 * 4.0 # 4x heli speed, still a frame per step
		t0 = Time.get_ticks_usec()
		c._process(1.0 / 60.0)
		worst = maxf(worst, (Time.get_ticks_usec() - t0) / 1000.0)
		frames += 1
	print("flight over %d frames: worst frame %.1f ms, %d chunks, %d sites laid out, %d roads" % [frames, worst, c.loaded.size(), c._layouts.size(), c._edges.size()])
	assert(worst < 50.0, "no frame over 50 ms while flying")
	c.process_mode = Node.PROCESS_MODE_DISABLED
	heli.position = keep
	var out := OS.get_environment("WORLD_MAP")
	if out != "":
		_map(ch, out)
	print("WORLD OK")
	get_tree().quit(0)


## A new generator next to main's (no processing), sharing Game.seed.
func _fresh(main: Node2D) -> TileMapLayer:
	var ch: TileMapLayer = CM.new()
	ch.process_mode = Node.PROCESS_MODE_DISABLED
	main.add_child(ch)
	return ch


## [kind, position] of every prop and POI main gets while `f` runs, sorted.
func _props(main: Node2D, f: Callable) -> Array:
	var n := main.get_child_count()
	f.call()
	var out := []
	for i in range(n, main.get_child_count()):
		var p: Node = main.get_child(i)
		if p is Node2D and not p is TileMapLayer:
			out.append([p.get("kind") if p.get("kind") != null else p.get_child(0).texture.resource_path if p.get_child_count() > 0 and p.get_child(0) is Sprite2D else "", p.position.round()])
	out.sort_custom(func(x, y): return var_to_str(x) < var_to_str(y))
	return out


## Breadth-first search over road, plaza and car park cells (composed layers, nothing loaded) from `ends` to `goals`.
func _joined(ch: TileMapLayer, ends: Array, goals: Array) -> bool:
	var goal := {}
	for b: Vector2i in goals:
		goal[b] = true
	var drive: Array = CM.ROADS + [T.PLAZA, T.PARKING]
	var seen := {}
	var q := ends.duplicate()
	for e: Vector2i in q:
		seen[e] = true
	var i := 0
	while i < q.size() and i < 40000:
		var c: Vector2i = q[i]
		i += 1
		if goal.has(c):
			return true
		for dir: Vector2i in CM.DIRS:
			if not seen.has(c + dir) and (goal.has(c + dir) or ch._ft(c + dir) in drive):
				seen[c + dir] = true
				q.append(c + dir)
	return false


## Overview PNG of 12x12 macro cells round the start, a pixel per 3 cells, minimap colours, sites marked.
func _map(ch: TileMapLayer, path: String) -> void:
	var colors: Dictionary = preload("res://scripts/hud.gd").MAP_COLORS
	var half := 6 * CM.MACRO_CELLS
	var img := Image.create(half * 2 / 3, half * 2 / 3, false, Image.FORMAT_RGB8)
	for y in img.get_height():
		for x in img.get_width():
			var cell := Vector2i(x * 3 - half, y * 3 - half)
			img.set_pixel(x, y, colors.get(ch._ft(cell), Color(0.3, 0.3, 0.3)))
	for mx in range(-6, 6):
		for my in range(-6, 6):
			var s: Dictionary = ch.site(Vector2i(mx, my))
			if s.kind != "":
				var p: Vector2i = (s.center + Vector2i(half, half)) / 3
				img.fill_rect(Rect2i(p - Vector2i(2, 2), Vector2i(5, 5)), Color(1, 1, 0) if s.town else Color(1, 0.3, 0.9))
	img.save_png(path)
	print("map written to %s" % path)
